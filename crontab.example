# StudentUp bot cron — systemd timer badulu cron vadalanukunte (VPS/MilesWeb).
# v74: bot cron-only (portal ledu) — ee 4 lines anni automation.
#
# Install:
#   1. path ni mee project path tho marchandi (/opt/studentup leda /home/<user>/bot)
#   2. mkdir -p /opt/studentup/log   (v82: folder lekapothe cron output pothundi!)
#   3. crontab -e → kindha lines paste cheyandi
#
# Log rotation (v82: cron.log ki app rotation ledu — monthly truncate):
#   0 3 1 * * tail -c 500000 /opt/studentup/log/cron.log > /tmp/cron.log && mv /tmp/cron.log /opt/studentup/log/cron.log
#
# Hourly bot run (drafts prepare chestundi — publish human approval tarvata):
0 * * * * cd /opt/studentup && /opt/studentup/.venv/bin/python run.py >> /opt/studentup/log/cron.log 2>&1
# Telegram approvals (✅ Publish / 🗑️ Delete) — prathi 5 nimishalaki:
*/5 * * * * cd /opt/studentup && /opt/studentup/.venv/bin/python run.py --approval-poll >> /opt/studentup/log/approval.log 2>&1
# Site guardian (roju okasari health report):
0 7 * * * cd /opt/studentup && /opt/studentup/.venv/bin/python run.py --guardian >> /opt/studentup/log/guardian.log 2>&1
# Weekly site audit + media prune (Sunday 3 AM):
0 3 * * 0 cd /opt/studentup && /opt/studentup/.venv/bin/python run.py --site-audit >> /opt/studentup/log/audit.log 2>&1
30 3 * * 0 cd /opt/studentup && /opt/studentup/.venv/bin/python tools/prune_media.py --days 30 --apply >> /opt/studentup/log/prune.log 2>&1
# Weekly dead-link + orphan scan (Sunday 3:45 AM — rot links = trust loss):
45 3 * * 0 cd /opt/studentup && /opt/studentup/.venv/bin/python run.py --orphans >> /opt/studentup/log/links.log 2>&1
# v181 growth loops — readers' demand + GSC decay + sponsor sales (shared hosting safe):
30 8 * * *   cd /opt/studentup && /opt/studentup/.venv/bin/python run.py --search-demand --notify >> /opt/studentup/log/demand.log 2>&1
0 9 * * 1    cd /opt/studentup && /opt/studentup/.venv/bin/python run.py --rank-trend --csv /opt/studentup/private/Pages.csv --notify >> /opt/studentup/log/rank.log 2>&1
15 9 * * *   cd /opt/studentup && /opt/studentup/.venv/bin/python run.py --sponsor-crm --notify >> /opt/studentup/log/sponsor.log 2>&1
# v182 strategic loops (weekly plan · ad-data strategy · authority outreach):
45 8 * * 1   cd /opt/studentup && /opt/studentup/.venv/bin/python run.py --revenue-loop private/adsense-pages.csv --revenue-notify >> /opt/studentup/log/revenue.log 2>&1
0 9 * * 1    cd /opt/studentup && /opt/studentup/.venv/bin/python run.py --calendar --calendar-apply --calendar-notify >> /opt/studentup/log/calendar.log 2>&1
30 9 * * 1   cd /opt/studentup && /opt/studentup/.venv/bin/python run.py --backlink --backlink-notify >> /opt/studentup/log/backlink.log 2>&1
# v183 daily WhatsApp-forward list (plain text; copy-paste to groups):
35 8 * * *   cd /opt/studentup && /opt/studentup/.venv/bin/python run.py --forward-list >> /opt/studentup/log/forward.log 2>&1
# v186 live site audit (weekly): 16 HTTP checks (robots · sitemap · schema · PWA · 404 · caching):
0 10 * * 1   cd /opt/studentup && /opt/studentup/.venv/bin/python run.py --live-audit --live-notify >> /opt/studentup/log/live-audit.log 2>&1

