# StudentUp bot cron — systemd timer badulu cron vadalanukunte (VPS/MilesWeb).
# v74: bot cron-only (portal ledu) — ee 4 lines anni automation.
#
# Install:
#   1. path ni mee project path tho marchandi (/opt/studentup leda /home/<user>/bot)
#   2. mkdir -p /opt/studentup/log   (v82: folder lekapothe cron output pothundi!)
#   3. crontab -e → kindha lines paste cheyandi
#
# Log rotation (v82: cron.log ki app rotation ledu — monthly truncate):
#   0 3 1 * * tail -c 500000 /opt/studentup/log/cron.log > /tmp/cron.log && mv /tmp/cron.log /opt/studentup/log/cron.log
#
# Hourly bot run (drafts prepare chestundi — publish human approval tarvata):
0 * * * * cd /opt/studentup && /opt/studentup/.venv/bin/python run.py >> /opt/studentup/log/cron.log 2>&1
# Telegram approvals (✅ Publish / 🗑️ Delete) — prathi 5 nimishalaki:
*/5 * * * * cd /opt/studentup && /opt/studentup/.venv/bin/python run.py --approval-poll >> /opt/studentup/log/approval.log 2>&1
# Site guardian (roju okasari health report):
0 7 * * * cd /opt/studentup && /opt/studentup/.venv/bin/python run.py --guardian >> /opt/studentup/log/guardian.log 2>&1
# Weekly site audit + media prune (Sunday 3 AM):
0 3 * * 0 cd /opt/studentup && /opt/studentup/.venv/bin/python run.py --site-audit >> /opt/studentup/log/audit.log 2>&1
30 3 * * 0 cd /opt/studentup && /opt/studentup/.venv/bin/python tools/prune_media.py --days 30 --apply >> /opt/studentup/log/prune.log 2>&1
