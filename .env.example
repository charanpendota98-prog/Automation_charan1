# ================= studentup.in Auto-Blogger config =================
# Ivi fill chesi file ni ".env" ani peru marchandi (cp .env.example .env)

# --- WordPress (REQUIRED) ---
WP_SITE=https://studentup.in
WP_USERNAME=your_wp_username
# WordPress Application Password (spaces tho untundi — aa vidhanganey paste cheyandi)
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# publish = direct ga live | draft = Telegram lo review chesi approve cheyali (recommended)
DEFAULT_POST_STATUS=draft
# 1 = every automated article stays a WordPress draft for Telegram/human review
AUTOMATION_DRAFT_ONLY=1

# --- Telegram notifications + approval bot ---
# 1) Telegram lo @BotFather open cheyandi -> /newbot -> token teesuko
# 2) Token ikkada paste cheyandi. Chat id emi ivvakarledu — bot ki /start cheyte
#    automatic ga register avtundi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- WhatsApp alerts (optional, CallMeBot free) ---
# WhatsApp lo +34 644 66 32 62 number ki "I allow call mebot to send me messages"
# ani send cheyandi -> apikey vastundi -> URL ikkada pettandi:
# WHATSAPP_CALLMEBOT_URL=https://api.callmebot.com/whatsapp.php?phone=+91XXXXXXXXXX&apikey=XXXX
WHATSAPP_CALLMEBOT_URL=

# --- Gemini AI (REQUIRED) — https://aistudio.google.com lo free key ---
GEMINI_API_KEY=your_gemini_api_key
# v18: multi-key rotation — free tier 429 vasthe automatic ga next key ki
# (comma tho all keys; GEMINI_API_KEY main key ga undagane okati, list optional)
GEMINI_API_KEYS=key2_here,key3_here,key4_here
GEMINI_RPD_PER_KEY=1400
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash
# v68: API base URL (proxy/gateway vaadithe marchandi). Default Google official.
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# 429/timeout vasthe entha retry cheyali (key rotation tarvata)
GEMINI_MAX_RETRIES=3

# --- Schedule ---
# Quality-first draft slots; human review decides what gets published.
DAILY_MIN=3
DAILY_MAX=5
ACTIVE_HOUR_START=6
ACTIVE_HOUR_END=22
TIMEZONE=Asia/Kolkata

# --- Content ---
# Category priority — extra tickets (revenue weighting; 0 = boost ledu)
# CATEGORY_PRIORITY=Central Govt Jobs:4,TS Govt Jobs:4,AP Govt Jobs:3,Results:3,Software Jobs:2,Private Jobs:2
CATEGORIES=Scholarships,Govt Jobs,Education News,Exam Updates,Admissions,Results,Internships,Study Tips

# --- Images ---
IMAGE_ENABLED=1
IMAGE_WIDTH=1200
IMAGE_HEIGHT=675
SITE_BRAND=studentup.in

# --- v68: Socials + Contact (ivi theme ki automatic ga push avutayi) ---
# "python run.py --push-theme-data" — site header/footer/sidebar lo kanipistayi
# Khali unte theme default (owner-verified number) vadutundi — marchali ante ikkada pettandi
# 10-digit mobile chaalu (+91 avasaram ledu — wa.me link kosam theme auto-add chestundi)
# SOCIAL_WHATSAPP=9182739312
SOCIAL_WHATSAPP=
SOCIAL_TELEGRAM=https://t.me/studentup_in
SOCIAL_INSTAGRAM=
SOCIAL_YOUTUBE=https://www.youtube.com/@studentupin
# Corrections/contact email (author box + policy pages lo kanipistundi)
CONTACT_EMAIL=

# --- v68: Google Indexing API (JobPosting instant indexing — OPTIONAL) ---
# Service account JSON path (Oracle VM lo recommended). Console lo "Indexing API"
# enable chesi, SA email ni **Search Console lo Owner ga** add cheyandi.
# GOOGLE_INDEXING_SA_JSON=/opt/studentup/service-account.json
# Ledaa inline JSON (okate line lo, .env ki safe):
# GOOGLE_INDEXING_SA={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n..."}
# Signing: `cryptography` package ledaa openssl CLI (Linux lo default untundi)

# --- v68: Ad overrides (theme options lo set cheyyakapote ivi vaadutayi) ---
# STICKY_AD=          (theme lo sticky/mobile ad HTML — AdSense-compliant mattrame)
# HOUSE_ADS_PATH=     (house ads JSON file path — direct/private ads)
# AD_TRAFFIC_PATH=    (traffic JSON — ad advisor/revenue engine)

# --- Advanced ---
# MULTI-SOURCE RESEARCH: URL ichaka bot internet lo same topic articles search chesi
# (DuckDuckGo, API key ledu) anni facts MERGE chesi super-complete article chestundi
RESEARCH_ENABLED=1
NOTEBOOKLM_AUTO_BUNDLE=1       # private evidence bundle + cited prompt for NotebookLM
NOTEBOOKLM_REQUIRED=0           # set 1 only when a validated cited brief is supplied
# Primary + up to 5 extras; live source posts need 3 independent domains,
# at least 1 official source and cross-source confidence >=65.
RESEARCH_MAX_SOURCES=5
# No evidence-free AI post may go live (quiz is exempt).
SOURCE_REQUIRED_ALL=1
AUTO_SOURCE_ONLY=1
SOURCE_MIN_LIVE=3
SOURCE_MIN_OFFICIAL=1
SOURCE_CONFIDENCE_MIN=65
SOURCE_AUDIT_BLOCK=1
# Do not create a source-derived draft unless evidence/facts/claims pass
SOURCE_PREFLIGHT_REQUIRED=1
CONTENT_QUALITY_BLOCK=1
# Keep source/automation disclosures in the private ledger, not reader-facing posts.
PUBLIC_EDITORIAL_CLEAN=1
# v103: live exact-phrase originality check; Google CSE credentials unte actual Google,
# lekapothe configured fallback engine. Required=1 aithe unavailable check publish block.
ORIG_LIVE_CHECK=1
ORIG_LIVE_PHRASES=3
ORIG_LIVE_REQUIRED=0
# v104: claim provenance + original practical value gate for live publishing
EDITORIAL_VALUE_MIN=55
EDITORIAL_VALUE_BLOCK=1
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
# v107: optional direct GSC API (service account must have property access)
GSC_SITE_URL=https://studentup.in
GSC_SERVICE_ACCOUNT_FILE=
# Never commit this JSON; environment secret is supported too.
GSC_SERVICE_ACCOUNT_JSON=
# Optional PageSpeed Insights API key (public endpoint may work without it)
PAGESPEED_API_KEY=
# v113: action-only Telegram alerts from control center; duplicate alerts suppressed
OPS_ALERTS_ENABLED=1
# v114: scheduler daily GSC API sync + action alerts (credentials lekunte safe skip)
GSC_AUTO_SYNC=1
GSC_SYNC_HOUR=6
# Article/Breadcrumb/eligible JobPosting JSON-LD; visible FAQs stay HTML.
# FAQPage rich-result markup is intentionally disabled because Google retired it.
SEO_SCHEMA_ENABLED=1
# Telegram CHANNEL auto-post (publish ayyaka instant traffic; optional)
# Channel lo bot ni admin ga add cheyandi, chat id (-100... format) ikkada pettandi
TELEGRAM_CHANNEL_CHAT_ID=
# --- v68: INSTANT INDEXING (Bing/Yandex + Google JobPosting) ---
# IndexNow: key ni ikkada pettandi — **key file ni theme ne serve chestundi**
# (`/<key>.key`), cPanel lo upload cheyyalsina pani ledu.
# Generate: python run.py --index-key-gen  ·  Verify: python run.py --index-status
INDEXNOW_KEY=
# Local images upload tarvata delete (disk save; 1 = keep cheyali)
KEEP_IMAGES=0
# Scheduler watchdog alert hours
WATCHDOG_HOURS=26
# Search fallback endpoint (block aite lite try chestundi)
# SEARCH_FALLBACK_ENDPOINT=https://lite.duckduckgo.com/lite/
INDEXNOW_KEY=
# Source URLs queue file (okka URL okka line) — scheduler priority ga process chestundi
# SOURCES_QUEUE_PATH=/path/to/sources_queue.txt
# Rank Math meta REST dwara set cheyadam (plugin lekapothe automatic skip)
# RANK_MATH_META_ENABLED=1

# --- v68: Advanced overrides (aavasaram lekapote touch cheyyakandi) ---
# HTTP_TIMEOUT=90                 (network timeout seconds)
# SEARCH_ENDPOINT=https://html.duckduckgo.com/html/
# STATE_PATH=logs/state.json      (publish state + dedupe memory)
# OUTPUT_DIR=output               (drafts/images/proofs)
# LOG_DIR=logs                    (daily logs)
# TELEGRAM_API_BASE=https://api.telegram.org
# GUARDIAN_STATE=logs/guardian.json
# AD_ADVISOR_STATE=logs/ad_advisor_state.json

# --- Stories/Listicles + Refresh (quality-first) --------------------------
# Roju one evidence-backed listicle draft at most; human review is required.
LISTICLES_PER_DAY=1
# Daily auto-refresh only for genuinely aging posts (source review required).
AUTO_REFRESH_PER_DAY=1
AUTO_REFRESH_MIN_AGE_DAYS=30
# v101: refresh lo nijamaina change lekunda dateModified bump cheyyakudadu
# (Google Aug-2026 spam update "deceptive freshness" ni target chesindi)
FRESHNESS_MIN_CHANGE_PCT=8
FRESHNESS_MIN_PUBLISH_PCT=2
AUTO_REFRESH_HOUR=21
# --- Daily Quiz Engine (v26) — exam-style interactive quizzes ---
# Roju okka quiz post automatic ga publish avutundi (QUIZ_HOUR tarvata)
QUIZ_ENABLED=1
QUIZ_CATEGORY=Daily Quiz
QUIZ_HOUR=8
QUIZ_QUESTIONS=10
QUIZ_SUNDAY_QUESTIONS=20
QUIZ_TIME_PER_Q=60
QUIZ_NEGATIVE_MARK=1
# auto = day-of-week difficulty ramp (Mon L1 ... Sun Top-Level); 1-4 = fixed
QUIZ_LEVEL=auto
QUIZ_LANGUAGE=te-en
# In-content ads: site lo WP Quads / Advanced Ads plugin shortcode iste
# ivvandi (empty = off). Bot 3 safe positions lo insert chestundi.
AD_SHORTCODE=
# Page ki intha ad slots (3 default; long articles ki 4-5 news standard)
MAX_AD_SLOTS=3
# Ad space reserve (CLS radu — Core Web Vitals + viewability better)
AD_CLS_WRAPPER=1
# Article schema publisher logo URL (E-E-A-T rich results; optional)
SITE_LOGO_URL=
# Google Discover: post robots lo max-image-preview:large (Rank Math meta)
DISCOVER_META_ENABLED=1
# Google Trends daily RSS (India) — trending education topics auto-post
USE_TRENDS=1
# TRENDS_RSS=https://trends.google.com/trending/trendingsearches/daily/rss?geo=IN
# --- Revenue (v6) ---
# Telegram channel URL — prathi post end lo join CTA (repeat traffic = more revenue)
TELEGRAM_CHANNEL_URL=
# Affiliate links 'label|url|keywords' okka line okati (keywords optional;
# post title/category match aithe matrame relevant posts lo vastundi)
# Example: Free Resume Builder|https://example.com/?ref=su|internship,job
AFFILIATE_LINKS=
# Optional commercial-intent mix; only publish topics with genuine student value.
# This is not a CPC or revenue guarantee.
HIGH_CPC_SHARE=30

# --- v15: District Breaking-News Radar (TS 33 + AP 26 districts) ----------
# Google News RSS (Telugu) real news — edu-relevant items queue; mana
# pipeline 100% original article rastundi (fake news kaadu).
RADAR_ENABLED=1
RADAR_HOUR=7
RADAR_INTERVAL_HOURS=6           # roju 4x scan — competitors kante munduga
RADAR_DISTRICTS_PER_RUN=10
RADAR_SOURCES_PER_RUN=10         # rotation batch (daily 17 prathi run lo)
RADAR_POSTS_PER_DAY=10              # source-backed review drafts per radar day; strict gates remain

# v59: site బ్రేకింగ్ న్యూస్ టికర్ + section (radar → preview/data/breaking.json)
BREAKING_ENABLED=1
BREAKING_MAX=8                    # ticker/section lo chupinche max headlines
BREAKING_KEEP_HOURS=18            # chivari headlines enni gantalu ticker lo nilabadali

# v60: SITE GUARDIAN — roju okkasari system motham check (site/UI/SEO/ads/feed/storage)
GUARDIAN_ENABLED=1
GUARDIAN_HOUR=20                  # IST — raatri report Telegram ki
GUARDIAN_FEED_MAX_AGE=26          # breaking feed enni gantalu fresh ga undali

# v73: countdown/deadline push ledu — hero card user brief tho teesesaamu.
# Deadlines ippudu post content + official notification lo mattrame (fake timer ledu).
# BREAKING_FEED_PATH=preview/data/breaking.json   # default ide (marchali ante)
# Manam follow avalsina channels/websites (comma-separated):
# Example: WATCH_SOURCES=https://t.me/s/adda247telugu,https://site.com/feed
# (Telegram public channels t.me/s/ format lo ivvali — bot join avalsadu)
WATCH_SOURCES=

# --- v16: Viral stories + tips share (%) in daily rotation ---
VIRAL_LISTICLE_SHARE=30
TIPS_SHARE=15

# --- v17: Keyword Dominance Engine ---
KEYWORD_DAILY_QUEUE=4            # roju intha keyword-gap topics
KEYWORD_SUGGEST_SEEDS=           # custom autocomplete seeds (empty = auto top exams)

# --- v17.1: Gemini output budget (Telugu truncation fix) ---
# 2.5 models ki thinking OFF + ee token budget (2.0/1.5 fallback auto-clamp 8192)
GEMINI_MAX_OUTPUT_TOKENS=32768

# v18 Rank Math strict gate: target score (below ante 1 automatic refine round)
RM_TARGET=100    # v64: Rank Math 100 target
# v95: in-body contextual internal links (paragraph lopala) max count
CONTEXTUAL_LINKS_MAX=3
# v96: district job hubs (TS 33 + AP 26) — thin-page guard.
# Ee count kanna takkuva posts unna district ki page CREATE AVVADU
# (khali shelves = Google scaled-content + AdSense low-value risk).
# CLI: python run.py --district-hubs [--district-hubs-apply]
DISTRICT_HUB_MIN_POSTS=3

# v97: real-time keyword verification — focus keyword ni Google Autocomplete
# tho live verify chestundi (LLM invent chesina "complete details" lanti
# demand-leni keywords ni nijamaina search phrase tho replace chestundi).
# API key avasaram ledu. 0 pedithe off (offline/CI).
KW_VERIFY=1
KW_VERIFY_TTL=3600   # seconds — same prefix cache (Google ni hammer cheyyakudadu)

# v99: FAQPage schema (AI search visibility). Google FAQ rich result poyindi
# (May 2026), kaani AI retrieval (Bing Copilot / Perplexity / AI Overviews)
# inka schema ni vadutundi. Nijamaina visible Q&A 2+ unte MATRAME emit avutundi.
FAQ_SCHEMA_ENABLED=1

# v100: weekly maintenance automatic ga (cron lo hub-rebuild slot lo).
# 0 pedithe off chesi CLI tho manual ga run chesukovachu.
DISTRICT_HUBS_AUTO=1
LINK_GRAPH_AUTO=1
LINK_GRAPH_LIMIT=100    # weekly link-graph crawl lo entha posts scan cheyyali
RM_REFINE_ROUNDS=2
# Rank Math regular-post content recommendation; do not pad articles to 1500 words
RM_MIN_WORDS=600
# Near-copy hard floor: rewrite idthiste ee source SKIP (AdSense rule #1)
ORIG_HARD_FLOOR=80
# Mobile headings clamp CSS (0 = off)
MOBILE_HEADLINE_TUNE=1

# v19: Google Jobs schema (0 = off), corrections contact, near-dup guard
JOB_SCHEMA_ENABLED=1
SUPPORT_EMAIL=studentupinformative@gmail.com
DUP_JACCARD_SKIP=0.62

# v20: real bylines (Google News needs), hub exams, sponsored CTA (disclosed)
AUTHOR_TEAM=Charan Pendota:Founder & Editor;Anand:Content Manager;Naga Prathyu:Content Writer
HUB_EXAMS=SSC CGL,SSC CHSL,SSC MTS,RRB Group D,RRB ALP,TET,TS DSC,TSPSC Group 2,APPSC Group 2,ICET,TS Police Constable,SBI PO,IBPS Clerk,Scholarships
FEATURED_CTA_HTML=

# v21: fact guard (dates/counts vs source), public channel auto-broadcast
FACT_STRICT=1
# TELEGRAM_CHANNEL_CHAT_ID=-1001234567890   # public channel id (bot lu channel lo admin kavali)

# v22: okka command tho full site settings audit+fix (WP admin creds vasthee):
#   .venv/bin/python run.py --setup            (apply)
#   .venv/bin/python run.py --setup --dry-run  (preview matrame)

# --- v28: plugins + AdSense Auto Ads + theme audit ------------------------
# Only these four reviewed WordPress.org slugs can be auto-installed.
PLUGIN_AUTO_INSTALL=1
PLUGIN_AUTO_ACTIVATE=1
AUTO_INSTALL_PLUGINS=rank-math,redirection,updraftplus,wp-super-cache
# Setup never changes the active theme. It audits it and recommends a fast one.
#   .venv/bin/python run.py --theme-audit
# AdSense approval is NOT automatic. After approval, paste the client id here.
# The kit emits only Google's Auto Ads loader, never forced ad clicks/units.
ADSENSE_ENABLED=1
ADSENSE_AUTO_ADS=1
# Keep 0 until Google approves the AdSense account. No ad spaces or loader
# are emitted while this is 0.
ADSENSE_APPROVED=0
# ADSENSE_CLIENT_ID=ca-pub-1234567890123456
#   .venv/bin/python run.py --adsense-kit --dry-run
#   .venv/bin/python run.py --adsense-kit
# Consent: set the real Google-certified CMP/provider used by the site.
# ADSENSE_CONSENT_PROVIDER=Google-certified-CMP-name
# Optional consent-safe analytics (empty/off by default)
GA4_ENABLED=0

# --- v43 AD MANAGER — owner ads (college banners, shop, services) ---
# Personal/self-serve ads in ads/inventory.json (repo lo). 100% AdSense/FTC
# policy-safe: visible "SPONSORED" label + rel="sponsored nofollow" + CLS-safe
# blocks + no ads adjacent to links. Empty/missing inventory = no-op.
# run.py --ads      → inventory status + per-category slot plan (dry)
# run.py --ads-demo → visible placement preview (output/ads-preview.html)
# Strategy + high-CTR safe rules: AD_STRATEGY_ADVANCED.md
AD_MANAGER_ENABLED=1
# Post lo max personal ad slots (AdSense in-content slots ki separate).
# ADSENSE_APPROVED=1 unte idi auto 1 ki drop avtundi (AdSense safe coexist).
MAX_PERSONAL_AD_SLOTS=2
# v52: sponsor ad lekapoyinappudu mana sonta ads (ads/house.json) vastayi
HOUSE_AD_ENABLED=1

# --- v57: Ad advisor — eppudu e ad-network ki apply cheyyali (automatic) ---
# Roju AD_ADVISOR_HOUR tarvata bot okkasari check chesi, kotha network threshold
# cross ayithe Telegram alert pampistundi (milestone ki okkasari).
AD_ADVISOR_ENABLED=1
AD_ADVISOR_HOUR=10
# Traffic data (GA4 CSV import: python run.py --ad-advisor --traffic-csv ga4.csv)
# leda ikkada nerugaa:
AD_MONTHLY_VIEWS=0
AD_MONTHLY_SESSIONS=0
AD_TIER1_SHARE=0
# v48: 1 = category match lekapoyina ad miss avvadu (fair rotation tho next ad).
#      0 = strict — category match unte matrame ad.
AD_FALLBACK_ALWAYS=1
# Inventory path override (default: repo ads/inventory.json)
# ADS_INVENTORY_PATH=/path/to/inventory.json

# --- v44 DEEP POST ENGINE — deep analyse + cross-source verification ---
# >= DEEP_MIN_SOURCES sources unna posts ki visible "In-Depth Analysis"
# section (verified facts table + conflict box + gap box + confidence) +
# perfect gate: source conflicts / 2 different last-dates / stale years
# = LIVE publish BLOCK (drafts lo flags). Manual workflow:
# MANUAL_ADVANCED_CHECKLIST.md (deep-research → NotebookLM → generate).
DEEP_POST_ENABLED=1
DEEP_MIN_SOURCES=2
# 0 = deep gate off (emergency only — permanent ga off cheyaku)
DEEP_GATE_STRICT=1
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# Full production audit (does not auto-claim Google approval/revenue):
#   .venv/bin/python run.py --production-audit

# --- v31: Student Internet Center service page + private case metadata ------
SERVICE_CENTER_ENABLED=1
SERVICE_CENTER_NAME=StudentUp Internet Center
SERVICE_CENTER_CITY=Hyderabad
# Configure a real business number before publishing the page.
# SERVICE_CENTER_PHONE=+91XXXXXXXXXX
# SERVICE_CENTER_WHATSAPP=+91XXXXXXXXXX
# SERVICE_CENTER_EMAIL=your-business-email@example.com
SERVICE_CENTER_PAGE_SLUG=student-services
# Prefer a private upload portal/one-time link. Empty = tell callers to request one.
# SERVICE_CENTER_UPLOAD_URL=https://secure-upload.example.com/studentup
SERVICE_RETENTION_DAYS=30
# SERVICE_CENTER_DB=/secure/private/path/service_center.db

# --- v35: quality and editorial safeguards ---------------------------------
PUBLISH_QA_MIN_SCORE=80
PUBLISH_ORIGINALITY_MIN=72
# Leave blank unless a named person actually reviewed the source-backed draft.
EDITORIAL_REVIEWER=

# --- v33: Google-facing public audit ---------------------------------------
# Optional PSI API key if Google's public quota requires one.
# PAGESPEED_API_KEY=your_pagespeed_key
GOOGLE_AUDIT_TIMEOUT=90
#   .venv/bin/python run.py --google-audit https://studentup.in/

# --- v36: NotebookLM-ready source-grounded research -----------------------
RESEARCH_BRIEF_DIR=output/research
#   .venv/bin/python run.py --research-brief "TSPSC Group 2 2027 notification" --research-year 2027
#   .venv/bin/python run.py --research-brief "TSPSC Group 2 2027" --research-urls checked_urls.txt --research-year 2027
# Preview page without WordPress writes:
#   .venv/bin/python run.py --service-center --dry-run
# Publish/update slug-safe WP page:
#   .venv/bin/python run.py --service-center


# --- v38: Top Post Dominance Engine ----------------------------------------
# "Top post" = blueprint → write → measure → harden → gate (claims kaadu).
TOP_POST_ENGINE=1
# Live publish ki minimum Top Post Score (drafts eppudu allow; 78 default).
TOP_POST_MIN_SCORE=78
# score < target unte live publish block (draft-first lo enforce kaadu).
TOP_POST_STRICT=1
# Score lo minimum word target + over-optimization ceiling (keyword density).
TOP_POST_WORDS_TARGET=1500
TOP_POST_MAX_DENSITY=0.03
# Domination calendar default length (--top-post-plan).
TOP_POST_PLAN_DAYS=90
#   .venv/bin/python run.py --top-post "SSC CGL 2026 apply online"
#   .venv/bin/python run.py --top-post "NSP Scholarship last date" --publish-top-post
#   .venv/bin/python run.py --top-post-plan --top-post-days 90
#   .venv/bin/python run.py --keyword-universe
#   .venv/bin/python run.py --score-post output/top-posts/x.html --score-keyword "..."

# --- v74: shared hosting cron (exam portal teesesam — bot cron-only) ---------
# MilesWeb/cPanel cron lo approvals kosam (24×7 daemon avasaram ledu):
#   */5 * * * *  /home/<user>/bot/.venv/bin/python /home/user/bot/run.py --approval-poll
# Bot runs kosam crontab.example chudandi.

# v65: pin-to-pin certificate gate (critical fail unte publish aaputundi)
PIN_GATE_BLOCK=1
# v65: Google Trends/Suggest capture (radar lo automatic; --trends manual)
TRENDS_ENABLED=1
TRENDS_GEO=IN
