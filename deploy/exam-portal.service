# v39 College Exam Portal — systemd unit (Ubuntu/Debian VPS)
# Install: sudo cp deploy/exam-portal.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now exam-portal
# NOTE: portal 127.0.0.1 lo bind avutundi — HTTPS + public access Caddy/nginx reverse
#       proxy tho (deploy/Caddyfile). Direct 0.0.0.0 vadakandi (admin key + student data).
[Unit]
Description=StudentUp College Exam Portal (v39)
Documentation=https://github.com/charanpendota98-prog/Automation_charan1
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=studentup
Group=studentup
WorkingDirectory=/opt/studentup
EnvironmentFile=-/opt/studentup/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/studentup/.venv/bin/python run.py --exam-portal \
          --exam-host 127.0.0.1 --exam-port 8080 --exam-db /opt/studentup/exam_portal.db
Restart=always
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM

# hardening (portal ki repo root lo write kavali — db/key/logs)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/studentup
ProtectKernelTunables=true
RestrictSUIDSGID=true

StandardOutput=append:/var/log/studentup/exam-portal.log
StandardError=append:/var/log/studentup/exam-portal.log

[Install]
WantedBy=multi-user.target
